{
  "query_graph": {
    "nodes": {
      "$source": {
        "ids": ["$source_id"],
        "categories": ["biolink:ChemicalEntity"]
      },
      "nA": {
        "categories": ["biolink:Gene"]
      },
      "$target": {
        "ids": ["$target_id"],
        "categories": ["biolink:DiseaseOrPhenotypicFeature"]
      }
    },
    "edges": {
      "eA": {
        "subject": "$source",
        "object": "nA",
        "predicates": ["biolink:affects"],
        "constraints": {
          "qualifiers": [
            {
              "biolink:object_direction_qualifier": "increased",
              "biolink:object_aspect_qualifier": "activity_or_abundance"
            }
          ]
        }
      },
      "eB": {
        "subject": "nA",
        "object": "$target",
        "predicates": ["biolink:associated_with"],
        "constraints": {
          "qualifiers": [
            {
              "biolink:subject_form_or_variant_qualifier": "loss_of_function_variant_form",
              "biolink:qualified_predicate": "biolink:contributes_to"
            }
          ]
        }
      }
    }
  }
}
